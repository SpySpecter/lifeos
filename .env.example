# ─── LifeOS Konfiguration ──────────────────────────────────────────────
# Kopieren nach .env und ausfüllen. Leere Werte = Integration ausgeschaltet.

# Öffentliche Basis-URL im Tailnet (für OAuth-Redirects), ohne Slash am Ende
APP_URL=https://lifeos.taila65db2.ts.net
APP_TZ=Europe/Berlin
DATA_DIR=/data

# true = Fixture-Daten statt echter APIs (für Demos/Screenshots)
DEMO_MODE=false

# ─── Sicherheit ────────────────────────────────────────────────────────
# Nur Anfragen über `tailscale serve` (Header Tailscale-User-Login) zulassen
REQUIRE_TAILSCALE_AUTH=true
# Kommagetrennte Tailscale-Logins, z. B. SpySpecter@github (leer = jeder im Tailnet)
ALLOWED_TAILSCALE_USERS=
# 32 Byte, base64:  openssl rand -base64 32
ENCRYPTION_KEY=
# Token für den iPhone-Kurzbefehl:  openssl rand -base64 24
INGEST_TOKEN=

# ─── Schule (WebUntis) ─────────────────────────────────────────────────
# Server z. B. nessa.webuntis.com; Schulname steht in der WebUntis-URL (?school=...)
UNTIS_SERVER=
UNTIS_SCHOOL=
UNTIS_USER=
UNTIS_PASSWORD=

# ─── Google (Kalender, Gmail, Drive – nur lesend) ──────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Spotify (PKCE, kein Secret nötig) ─────────────────────────────────
SPOTIFY_CLIENT_ID=

# ─── GitHub (Fine-grained PAT, nur lesend) ─────────────────────────────
GITHUB_TOKEN=

# ─── Wetter & News ─────────────────────────────────────────────────────
# Fallback-Standort, solange der Browser keinen Standort freigibt
DEFAULT_LAT=52.52
DEFAULT_LON=13.405
# Name|URL, kommagetrennt
NEWS_FEEDS=Tagesschau|https://www.tagesschau.de/index~rss2.xml,heise|https://www.heise.de/rss/heise-atom.xml
